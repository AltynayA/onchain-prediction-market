{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "^0.8.24"
    ],
    "avoid-suicide": "error",
    "avoid-sha3": "warn",
    "no-empty-blocks": "off",
    "func-visibility": "off",
    "no-unused-vars": "warn",
    "quotes": [
      "warn",
      "double"
    ]
  }
}